{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre-push-ci.sh",
            "timeout": 900,
            "statusMessage": "push 前に CI 相当のチェックを実行中（scripts/ci-local.sh）"
          }
        ]
      }
    ]
  }
}
